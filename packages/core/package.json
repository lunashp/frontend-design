{
  "name": "@ce/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic engine: scan → classify → portability → tokenize → customize. Emits a serializable ComponentArtifact. Never imports Sandpack.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings ."
  },
  "dependencies": {
    "culori": "^4.0.1",
    "dependency-cruiser": "^16.4.0",
    "postcss": "^8.4.49",
    "postcss-modules": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "react-docgen-typescript": "^2.2.2",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/culori": "^2.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
