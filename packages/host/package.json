{
  "name": "@ce/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local HTTP + WebSocket server that wraps @ce/core for the web gallery. Reads target projects read-only.",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "test:browser:thumbnail": "tsc -p tsconfig.e2e.json --noEmit && tsx e2e/thumbnail-render.spec.ts"
  },
  "dependencies": {
    "@ce/core": "workspace:*",
    "esbuild": "0.28.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "playwright": "^1.61.1"
  }
}
