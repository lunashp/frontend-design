{
  "name": "@ce/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite + React gallery. Renders extracted components in isolated Sandpack iframes; browse, port, and customize.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "test:browser:gallery": "tsc -p tsconfig.e2e.json --noEmit && tsx e2e/gallery-virtualization.spec.ts"
  },
  "dependencies": {
    "@ce/core": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "vite": "^7.0.0"
  }
}
